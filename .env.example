# ============================================================
#  VERITAS-Assistent – Schlüssel und Einstellungen (nur Gemini)
#  Lokal: diese Datei nach .env.local kopieren und ausfüllen.
#  Vercel: dieselben Namen unter Project → Settings → Environment Variables.
#  Nichts davon gehört ins Git.
# ============================================================

# --- 1. Gemini (Pflicht) ----------------------------------------------
# Schlüssel: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text-Chat
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Optional: minimal | low | medium | high (leer = Standard des Modells)
GEMINI_THINKING_LEVEL=low

# --- 2. Sprache --------------------------------------------------------
# „Mit dem Assistenten sprechen“: Gespräch in Echtzeit
LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Aoede
# Maximale Gesprächsdauer in Sekunden (Kostenschutz)
CALL_MAX_SECONDS=300

# Mikrofon-Taste im Chat (Sprache → Text)
TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Antworten vorlesen
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Aoede

# --- 3. Rückruf-Anfragen – Supabase-Projekt „Assistants“ ---------------
# Eine Datenbank für alle Demo-Firmen; jede Anfrage bekommt company_id aus tenant/company.json
SUPABASE_URL=https://kmyhvnouzfwlzwyqgpzh.supabase.co
# Empfohlen: Secret Key (Supabase → Project Settings → API Keys → Secret keys)
SUPABASE_SECRET_KEY=
# Alternativ funktioniert auch der Publishable Key (darf nur neue Anfragen anlegen)
SUPABASE_PUBLISHABLE_KEY=

# Telegram-Benachrichtigung bei neuer Anfrage (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 4. Zugang und Demo ----------------------------------------------
# Zugangscode für die Demo (leer = Seite ist offen für alle)
DEMO_ACCESS_CODE=
# Hinweis „Konzept-Demo“ oben anzeigen: true | false
DEMO_BANNER=true
# Wer die Demo gebaut hat (steht im Hinweis)
DEMO_AUTHOR=Azamat
